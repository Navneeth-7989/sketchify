# Copy this file to .env.local and fill in real values.
# cp apps/web/.env.local.example apps/web/.env.local

# --- Database (Prisma / Postgres) ---
# Connection string for your Postgres database (e.g. a Neon project).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET="a-long-random-string"
# Base URL of the web app (use your production domain in prod).
AUTH_URL="http://localhost:3000"

# --- OAuth providers (optional; needed only for Google/GitHub sign-in) ---
# Email/password (Credentials) sign-up works without these.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Realtime collaboration ---
# MUST be identical to COLLAB_JWT_SECRET in apps/ws-server/.env,
# or the WebSocket server will reject every join token.
COLLAB_JWT_SECRET="a-long-random-string-shared-with-ws-server"
# WebSocket server URL. Use wss://... in production.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"
